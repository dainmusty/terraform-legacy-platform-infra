# Local .terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform plan files
tfplan
tfplan-*
drift.tfplan

# Sensitive variable files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files (local-only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock info
.terraform.tfstate.lock.info

# CLI configuration files
.terraformrc
terraform.rc

# OS junk
.DS_Store

# Ignore text files
*txt
